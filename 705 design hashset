class MyHashSet {
    private Bucket[] buckets;
    private int capacity;

    public MyHashSet() {
        capacity = 1000; // number of buckets
        buckets = new Bucket[capacity];
        for (int i = 0; i < capacity; i++) {
            buckets[i] = new Bucket();
        }
    }

    private int hash(int key) {
        return key % capacity;
    }

    public void add(int key) {
        int idx = hash(key);
        buckets[idx].insert(key);
    }

    public void remove(int key) {
        int idx = hash(key);
        buckets[idx].delete(key);
    }

    public boolean contains(int key) {
        int idx = hash(key);
        return buckets[idx].exists(key);
    }

    // Each bucket is implemented as a simple linked list to handle collisions
    private class Bucket {
        private LinkedList<Integer> container;

        public Bucket() {
            container = new LinkedList<>();
        }

        public void insert(int key) {
            int index = container.indexOf(key);
            if (index == -1) {
                container.addFirst(key);
            }
            // if key already exists, do nothing (set semantics)
        }

        public void delete(int key) {
            container.remove((Integer) key);
        }

        public boolean exists(int key) {
            return container.contains(key);
        }
    }
}
